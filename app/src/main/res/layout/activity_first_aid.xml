<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#0B0F19">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FIRST AID PROTOCOLS"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#00F2FE"
            android:letterSpacing="0.1"
            android:layout_marginBottom="20dp" />

        <!-- CPR Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_dark_card"
            android:padding="20dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01. CPR PROTOCOL"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FF4E50"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:text="• Place hands in the center of the chest.\n• Push hard and fast (100–120 BPM).\n• Continue until medical teams arrive."
                android:textColor="#94A3B8"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Bleeding Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_dark_card"
            android:padding="20dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02. SEVERE BLEEDING"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FF4E50"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:text="• Apply firm, direct pressure with clean cloth.\n• Elevate wound above heart level if possible.\n• Keep pressure constant without removing pads."
                android:textColor="#94A3B8"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Burns Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_dark_card"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="03. BURN TREATMENT"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FF4E50"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:text="• Cool burn under cold water for 10+ minutes.\n• Avoid ice, oil, or ointments on broken skin.\n• Cover loosely with sterile non-stick dressing."
                android:textColor="#94A3B8"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>